        "base_url": "http://localhost:8080",
        "token": "",
        "bookId": 1,
        "bookId2": 9,
        "orderId": 1,
        "addressId": 1,
        "publisherId": 1,
        "authorId": 1
      }
    },

    {
      "_id": "fld_auth",
      "_type": "request_group",
      "parentId": "wrk_bookworm",
      "name": "1. Auth (register + login)"
    },
    {
      "_id": "req_register",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "POST /auth/register",
      "method": "POST",
      "url": "{{ base_url }}/api/v1/auth/register",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"Secret123!\",\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Reyes\"\n}"
      }
    },
    {
      "_id": "req_login",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "POST /auth/login",
      "method": "POST",
      "url": "{{ base_url }}/api/v1/auth/login",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"Secret123!\"\n}"
      }
    },

    {
      "_id": "fld_account",
      "_type": "request_group",
      "parentId": "wrk_bookworm",
      "name": "2. Account (profile + addresses + recommendations)"
