      "url": "{{ base_url }}/api/v1/me",
      "headers": [{ "name": "Authorization", "value": "Bearer {{ token }}" }]
    },
    {
      "_id": "req_get_addresses",
      "_type": "request",
      "parentId": "fld_account",
      "name": "GET /me/addresses — list saved addresses",
