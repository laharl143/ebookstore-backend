      "parentId": "fld_account",
      "name": "POST /me/addresses — save delivery address",
      "method": "POST",
      "url": "{{ base_url }}/api/v1/me/addresses",
      "headers": [
        { "name": "Authorization", "value": "Bearer {{ token }}" },
        { "name": "Content-Type", "value": "application/json" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Reyes\",\n  \"addressLine\": \"123 Mabini Street\",\n  \"city\": \"Manila\",\n  \"province\": \"Metro Manila\",\n  \"zipCode\": \"1000\",\n  \"phone\": \"+639171234567\",\n  \"isDefault\": true\n}"
      }
    },
    {
      "_id": "req_recommendations",
      "_type": "request",
      "parentId": "fld_account",
      "name": "GET /me/recommendations — personalised books",
      "method": "GET",
      "url": "{{ base_url }}/api/v1/me/recommendations?size=12",
      "headers": [{ "name": "Authorization", "value": "Bearer {{ token }}" }]
    },

    {
